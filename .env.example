POSTGRES_USER=hatlanh
POSTGRES_PASSWORD=hatlanh
POSTGRES_DB=hat_lanh
DATABASE_URL=postgresql://hatlanh:hatlanh@localhost:5432/hat_lanh
TEST_DATABASE_URL=postgresql://hatlanh:hatlanh@localhost:5432/hat_lanh_test
ADMIN_PASSWORD=ChangeMe123!

# API
PORT=3000
JWT_SECRET=dev-only-jwt-secret-change-me
# dev = fake OAuth login (POST /auth/dev-login) for local work; unset or live = disabled (404)
OAUTH_MODE=dev
# max login/register attempts per IP per minute
AUTH_RATE_LIMIT=10
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Portal (Next.js, port 3001) — read from this root .env
# API address used by server-side rendering
API_URL=http://localhost:3000
# API address used in the browser (inlined at build time)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Public address of the portal (absolute links in Open Graph / canonical tags)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Portal Google/Facebook buttons: dev = open the test sign-in form (calls /auth/dev-login, needs OAUTH_MODE=dev);
# unset = buttons show "Sắp có". Inlined at build time. Never dev in production.
NEXT_PUBLIC_OAUTH_MODE=dev

# Admin (Vite): API address the browser calls; inlined at build time.
VITE_API_URL=http://localhost:3000
