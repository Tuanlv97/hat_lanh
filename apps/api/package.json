{
  "name": "@hatlanh/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node -e \"console.log('@hatlanh/api: placeholder dev script')\"",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:generate": "prisma generate",
    "test": "jest --runInBand"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hatlanh/shared": "*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "jest": "^29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0"
  }
}
